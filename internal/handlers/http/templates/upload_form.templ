package templates

templ UploadForm() {
	<div class="bg-obsidian-800/90 border border-obsidian-border rounded-2xl p-6 sm:p-8 shadow-2xl relative overflow-hidden glow-card">
		<!-- Header -->
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-6 border-b border-obsidian-border/80">
			<div>
				<div class="flex items-center gap-2">
					<span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider bg-brand-500/10 text-brand-400 border border-brand-500/20">Ingestion Gateway</span>
					<span class="text-xs text-slate-500">•</span>
					<span class="text-xs text-slate-400">HTTP 202 Accepted Async Ingestion</span>
				</div>
				<h2 class="text-xl font-bold text-white mt-1">Submit Media or Document Task</h2>
				<p class="text-xs text-slate-400 mt-0.5">Upload a file for asynchronous background processing, thumbnailing, and metadata extraction.</p>
			</div>

			<!-- Quick Demo One-Click Test Buttons -->
			<div class="flex flex-wrap items-center gap-2">
				<span class="text-[11px] text-slate-500 font-mono hidden lg:inline">Quick Demo:</span>
				<button
					type="button"
					hx-post="/demo/upload?type=image"
					hx-target="#job-container"
					hx-swap="afterbegin"
					hx-indicator="#demo-image-spinner"
					class="px-3 py-1.5 rounded-lg bg-obsidian-700 hover:bg-obsidian-600 border border-obsidian-border hover:border-brand-500/40 text-xs font-medium text-slate-200 transition-all flex items-center gap-1.5 cursor-pointer"
				>
					<span id="demo-image-spinner" class="htmx-indicator animate-spin">⚡</span>
					<span>🖼️ Sample Image</span>
				</button>
				<button
					type="button"
					hx-post="/demo/upload?type=pdf"
					hx-target="#job-container"
					hx-swap="afterbegin"
					hx-indicator="#demo-pdf-spinner"
					class="px-3 py-1.5 rounded-lg bg-obsidian-700 hover:bg-obsidian-600 border border-obsidian-border hover:border-brand-500/40 text-xs font-medium text-slate-200 transition-all flex items-center gap-1.5 cursor-pointer"
				>
					<span id="demo-pdf-spinner" class="htmx-indicator animate-spin">⚡</span>
					<span>📄 Sample PDF</span>
				</button>
			</div>
		</div>

		<!-- Upload Form -->
		<form
			id="upload-form"
			hx-post="/upload"
			hx-target="#job-container"
			hx-swap="afterbegin"
			hx-encoding="multipart/form-data"
			hx-indicator="#upload-spinner"
			hx-on::after-request="if(event.detail.successful) { this.reset(); clearSelectedFile(); }"
			class="space-y-5"
		>
			<!-- Dropzone & File Selector -->
			<div class="relative">
				<label
					id="dropzone"
					class="w-full flex flex-col items-center justify-center border-2 border-dashed border-obsidian-border hover:border-brand-500/70 rounded-xl p-8 cursor-pointer bg-obsidian-900/60 hover:bg-obsidian-900 transition-all duration-200 group"
				>
					<div class="w-12 h-12 rounded-xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center mb-3 group-hover:scale-110 group-hover:bg-brand-500/20 transition-all duration-300">
						<svg class="w-6 h-6 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
						</svg>
					</div>
					<span class="text-sm font-semibold text-slate-200 group-hover:text-white transition-colors">Choose file or drag & drop</span>
					<span class="text-xs text-slate-400 mt-1">PNG, JPG, WebP, GIF, or PDF (up to 50 MB)</span>
					<input
						type="file"
						id="file-input"
						name="file"
						required
						accept=".png,.jpg,.jpeg,.webp,.gif,.pdf,image/png,image/jpeg,image/webp,image/gif,application/pdf"
						class="hidden"
						onchange="handleFileSelect(this)"
					/>
				</label>
			</div>

			<!-- Prominent Selected File Card Preview (Hidden by default, shown when file is picked) -->
			<div id="file-preview-card" class="hidden p-4 rounded-xl bg-obsidian-700 border border-brand-500/40 shadow-lg items-center justify-between gap-4">
				<div class="flex items-center space-x-3 overflow-hidden">
					<div id="file-preview-icon" class="w-10 h-10 rounded-lg bg-brand-500/20 border border-brand-500/30 flex items-center justify-center text-brand-400 text-lg shrink-0">
						📁
					</div>
					<div class="overflow-hidden">
						<div class="flex items-center gap-2">
							<span id="preview-filename" class="text-sm font-bold text-white truncate max-w-xs sm:max-w-md"></span>
							<span id="preview-badge" class="px-2 py-0.5 rounded text-[10px] font-mono bg-brand-500/20 text-brand-300 border border-brand-500/30"></span>
						</div>
						<span id="preview-filesize" class="text-xs font-mono text-slate-400"></span>
					</div>
				</div>
				<button
					type="button"
					onclick="clearSelectedFile()"
					class="px-3 py-1.5 rounded-lg bg-obsidian-800 hover:bg-rose-500/20 hover:text-rose-300 text-slate-400 text-xs font-medium border border-obsidian-border hover:border-rose-500/30 transition-all cursor-pointer shrink-0"
				>
					Remove
				</button>
			</div>

			<!-- Form Bottom Action Bar -->
			<div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">
				<div class="flex items-center gap-2 text-xs text-slate-400">
					<span class="w-2 h-2 rounded-full bg-brand-400"></span>
					<span>Auto-assigned TTL: <span class="font-mono text-slate-300">1 Hour</span></span>
				</div>

				<div class="flex items-center gap-3 w-full sm:w-auto justify-end">
					<span id="upload-spinner" class="htmx-indicator flex items-center gap-2 text-xs font-medium text-brand-400">
						<svg class="animate-spin h-4 w-4 text-brand-400" fill="none" viewBox="0 0 24 24">
							<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
							<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
						</svg>
						Dispatching to NATS...
					</span>

					<button
						type="submit"
						class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-500 hover:to-brand-400 text-white font-semibold text-sm shadow-lg shadow-brand-500/25 transition-all cursor-pointer flex items-center justify-center gap-2"
					>
						<span>Dispatch Job</span>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
						</svg>
					</button>
				</div>
			</div>
		</form>

		<script>
			function handleFileSelect(input) {
				const card = document.getElementById('file-preview-card');
				const filename = document.getElementById('preview-filename');
				const filesize = document.getElementById('preview-filesize');
				const badge = document.getElementById('preview-badge');
				const icon = document.getElementById('file-preview-icon');

				if (input.files && input.files[0]) {
					const file = input.files[0];
					filename.innerText = file.name;
					
					const sizeInKB = (file.size / 1024).toFixed(1);
					const sizeInMB = (file.size / (1024 * 1024)).toFixed(2);
					filesize.innerText = file.size > 1048576 ? `${sizeInMB} MB` : `${sizeInKB} KB`;

					if (file.type === 'application/pdf' || file.name.endsWith('.pdf')) {
						icon.innerText = '📄';
						badge.innerText = 'PDF Document';
					} else {
						icon.innerText = '🖼️';
						badge.innerText = file.type || 'Image';
					}

					card.classList.remove('hidden');
					card.classList.add('flex');
				} else {
					clearSelectedFile();
				}
			}

			function clearSelectedFile() {
				const input = document.getElementById('file-input');
				const card = document.getElementById('file-preview-card');
				input.value = '';
				card.classList.add('hidden');
				card.classList.remove('flex');
			}
		</script>
	</div>
}
