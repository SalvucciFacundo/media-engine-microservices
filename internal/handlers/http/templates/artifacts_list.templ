package templates

import (
	"fmt"
	"github.com/SalvucciFacundo/media-engine-microservices/internal/domain"
)

templ ArtifactsList(artifacts []domain.Artifact) {
	if len(artifacts) > 0 {
		<div class="mt-4 pt-4 border-t border-slate-700/60">
			<h4 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Generated Artifacts ({ fmt.Sprintf("%d", len(artifacts)) })</h4>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
				for _, art := range artifacts {
					<div class="flex items-center justify-between p-3 rounded-xl bg-slate-900/60 border border-slate-700/50 hover:border-slate-600 transition">
						<div class="flex items-center space-x-3 overflow-hidden">
							<div class="w-8 h-8 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 shrink-0">
								if art.ArtifactType == "thumbnail" || art.ArtifactType == "resized_image" || art.ArtifactType == "cover_thumbnail" {
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
									</svg>
								} else {
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
									</svg>
								}
							</div>
							<div class="truncate">
								<p class="text-xs font-medium text-slate-200 truncate">{ art.ArtifactType }</p>
								<p class="text-[10px] text-slate-500">{ fmt.Sprintf("%.1f KB", float64(art.FileSize)/1024.0) }</p>
							</div>
						</div>
						<a
							href={ templ.SafeURL(fmt.Sprintf("/artifacts/%s/download", art.ID)) }
							download
							class="px-2.5 py-1.5 rounded-lg bg-indigo-600/20 hover:bg-indigo-600 text-indigo-300 hover:text-white text-xs font-medium transition cursor-pointer flex items-center gap-1 shrink-0"
						>
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
							</svg>
							Download
						</a>
					</div>
				}
			</div>
		</div>
	}
}
