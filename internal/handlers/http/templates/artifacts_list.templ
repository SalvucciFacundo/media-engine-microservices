package templates

import (
	"fmt"
	"github.com/SalvucciFacundo/media-engine-microservices/internal/domain"
)

templ ArtifactsList(artifacts []domain.Artifact) {
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
		for _, art := range artifacts {
			<div class="p-3.5 rounded-xl bg-obsidian-900 border border-obsidian-border hover:border-brand-500/40 flex items-center justify-between gap-3 transition-all">
				<div class="flex items-center space-x-2.5 overflow-hidden">
					<div class="w-8 h-8 rounded-lg bg-brand-500/10 border border-brand-500/20 flex items-center justify-center shrink-0 text-sm">
						if art.ArtifactType == "thumbnail" {
							<span>🔍</span>
						} else if art.ArtifactType == "text_preview" {
							<span>📝</span>
						} else if art.ArtifactType == "webp_converted" {
							<span>⚡</span>
						} else {
							<span>📦</span>
						}
					</div>
					<div class="overflow-hidden">
						<span class="text-xs font-bold text-white block truncate">{ art.ArtifactType }</span>
						<span class="text-[11px] font-mono text-slate-400 block">{ fmt.Sprintf("%.1f KB", float64(art.FileSize)/1024.0) }</span>
					</div>
				</div>

				<a
					href={ templ.SafeURL(fmt.Sprintf("/artifacts/%s/download", art.ID)) }
					download
					class="px-2.5 py-1.5 rounded-lg bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold shadow transition-all flex items-center gap-1 shrink-0 cursor-pointer"
				>
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
					</svg>
					<span>Get</span>
				</a>
			</div>
		}
	</div>
}
